# Copy this file to .env.local and fill in YOUR real values.
# .env.local is gitignored and never committed.

MANIFEST_BASE_URL=https://api.manifest.build/v1
MANIFEST_API_KEY=your-api-key-here

CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-cloudflare-api-token
CF_D1_ID=your-d1-database-id

WORKER_URL=https://ai-directory-worker.your-subdomain.workers.dev
INTERNAL_API_KEY=generate-a-32-char-random-key

TELEGRAM_BOT_TOKEN=your-bot-token
ADMIN_TELEGRAM_ID=your-chat-id
